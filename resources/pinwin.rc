#include <windows.h>
1 ICON "../assets/icons/app.ico"
1 RT_MANIFEST "pinwin.manifest"
1 VERSIONINFO
FILEVERSION PINWIN_VERSION
PRODUCTVERSION PINWIN_VERSION
FILEFLAGSMASK 0x3fL
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "PinWin contributors\0"
            VALUE "FileDescription", "PinWin portable window manager\0"
            VALUE "FileVersion", PINWIN_VERSION_STR "\0"
            VALUE "InternalName", "PinWin\0"
            VALUE "OriginalFilename", "PinWin.exe\0"
            VALUE "ProductName", "PinWin\0"
            VALUE "ProductVersion", PINWIN_VERSION_STR "\0"
            VALUE "LegalCopyright", "MIT License; PinWin contributors\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
